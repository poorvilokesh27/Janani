# App
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=mysql://janani:janani@localhost:3306/janani_db

# Redis (optional - falls back to node-cron if absent)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string

# OTP
OTP_HMAC_SECRET=replace-with-32-char-secret
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
ALLOW_TEST_OTP=false
ALLOW_INTL=false

# Encryption (AES-256-GCM, must be exactly 32 bytes base64)
ENCRYPTION_KEY=replace-with-32-byte-base64-encoded-key

# CORS
CORS_ORIGINS=http://localhost:5173

# SMS Provider: console | msg91 | fast2sms | twilio
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=JANANI
SMS_OTP_TEMPLATE_ID=
SMS_REMINDER_TEMPLATE_ID=

# Maps Provider: google | osm
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Feature flags
EMERGENCY_ACTIVATION_WEEK=36
REMINDER_SEND_HOUR_IST=9
DEFAULT_SEARCH_RADIUS_M=5000
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,kn,hi
